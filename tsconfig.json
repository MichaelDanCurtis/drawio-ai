{
	"compilerOptions": {
		"module": "commonjs",
		"target": "es2020",
		"outDir": "out",
		"lib": ["es2022"],
		"sourceMap": true,
		// The Mapper is the desktop app's own code (standalone/src/main/mapper), used as it is; so is
		// what writes an agent's export without following a link (standalone/src/main/exportTarget.ts).
		"rootDir": ".",
		"strict": true,
		"experimentalDecorators": true
	},
	"include": ["./src/**/*", "./drawio-custom-plugins/src/types.d.ts", "./standalone/src/main/mapper/**/*"],
	// Browser bundle with its own tsconfig (DOM lib, bundler resolution).
	"exclude": ["./src/codeblock-editor/guest"]
}
