{
	"name": "omnidraw-desktop",
	"productName": "OmniDraw",
	"version": "0.4.3",
	"private": true,
	"description": "OmniDraw: the draw.io editor with a chat that drives your own coding agents (Claude Code, Codex, Gemini, GitHub Copilot, Kimi) over the Agent Client Protocol, plus the Mapper.",
	"license": "GPL-3.0",
	"main": "out/main.js",
	"scripts": {
		"prepare-assets": "node scripts/prepare-assets.mjs",
		"build": "node build.mjs",
		"start": "node scripts/prepare-assets.mjs && node build.mjs && electron .",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"e2e": "node scripts/e2e.mjs",
		"dist": "node scripts/prepare-assets.mjs && node build.mjs && electron-builder --publish never",
		"dist:mac": "node scripts/prepare-assets.mjs && node build.mjs && electron-builder --mac --publish never",
		"dist:frame": "node scripts/prepare-assets.mjs && node build.mjs && node scripts/dist-frame.mjs"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "^2.8.0",
		"@anthropic-ai/sdk": "1.6.0",
		"@hediet/std": "^0.6.0",
		"js-sha256": "^1.1.0",
		"js-yaml": "^5.5.0",
		"mongodb": "^7.9.1",
		"mssql": "^12.8.0",
		"mysql2": "^3.24.6",
		"openai": "7.53.0",
		"oracledb": "^26.0.0",
		"pg": "^8.23.1"
	},
	"devDependencies": {
		"@excalidraw/excalidraw": "0.18.1",
		"@excalidraw/mermaid-to-excalidraw": "2.2.2",
		"@fontsource/doto": "^5.3.0",
		"@fontsource/space-grotesk": "^5.3.0",
		"@fontsource/space-mono": "^5.3.0",
		"@types/js-yaml": "^4.0.9",
		"@types/mssql": "^12.3.0",
		"@types/node": "^26.6.6",
		"@types/oracledb": "^26.0.1",
		"@types/pg": "^8.23.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/vscode": "1.105.0",
		"electron": "^45.4.1",
		"electron-builder": "^26",
		"esbuild": "^0.28.2",
		"fast-xml-parser": "^5.12.1",
		"mithril": "^2.0.4",
		"mobx": "^5",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"typescript": "^5.7.3"
	},
	"resolutions": {
		"@types/d3-selection": "3.0.12",
		"csstype": "3.2.3",
		"dompurify": "3.4.17",
		"source-map-js": "1.2.2",
		"tinyexec": "1.3.1"
	},
	"author": "Michael Curtis",
	"homepage": "https://github.com/MichaelDanCurtis/drawio-ai",
	"build": {
		"appId": "ai.luxis.omnidraw",
		"productName": "OmniDraw",
		"copyright": "GPL-3.0; includes draw.io (Apache-2.0)",
		"directories": {
			"output": "dist",
			"buildResources": "build"
		},
		"files": [
			"out/**/*",
			"!out/**/*.map",
			"package.json"
		],
		"asarUnpack": [
			"out/mcp-stdio-proxy.js"
		],
		"extraResources": [
			{
				"from": "../drawio/src/main/webapp",
				"to": "webapp",
				"filter": [
					"**/*",
					"!WEB-INF/**",
					"!META-INF/**"
				]
			},
			{
				"from": "../examples",
				"to": "examples"
			}
		],
		"mac": {
			"category": "public.app-category.developer-tools",
			"target": [
				"dmg",
				"zip"
			],
			"icon": "build/icon.png",
			"identity": "-",
			"hardenedRuntime": false
		},
		"win": {
			"target": [
				"nsis"
			],
			"icon": "build/icon.png"
		},
		"linux": {
			"target": [
				"AppImage"
			],
			"category": "Development",
			"icon": "build/icon.png"
		},
		"fileAssociations": [
			{
				"ext": [
					"drawio",
					"dio"
				],
				"name": "draw.io diagram",
				"role": "Editor"
			},
			{
				"ext": [
					"excalidraw"
				],
				"name": "Excalidraw drawing",
				"role": "Editor"
			}
		]
	}
}
