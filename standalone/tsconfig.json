{
	// Type-checks the app and the shared modules it imports from ../src (read-only).
	"compilerOptions": {
		"target": "es2022",
		"module": "preserve",
		"moduleResolution": "bundler",
		"lib": ["es2022", "dom"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"experimentalDecorators": true,
		"useDefineForClassFields": false,
		"jsx": "react-jsx",
		"types": ["node", "vscode"],
		"typeRoots": ["./node_modules/@types"],
		"paths": {
			"*": ["./node_modules/*", "./node_modules/@types/*"],
			// (the Excalidraw page: React's types are in @types, which the line above would only reach after the package itself)
			"react": ["./node_modules/@types/react"],
			"react/*": ["./node_modules/@types/react/*"],
			"react-dom": ["./node_modules/@types/react-dom"],
			"react-dom/*": ["./node_modules/@types/react-dom/*"]
		}
	},
	"include": ["src/**/*", "../drawio-custom-plugins/src/types.d.ts", "../src/types.d.ts"]
}
